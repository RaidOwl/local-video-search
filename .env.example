# ════════════════════════════════════════════════════════════════════════════
#  Local Video Search — Configuration
# ════════════════════════════════════════════════════════════════════════════
#
#  Copy this file to .env and edit as needed.
#
# ── HARDWARE_TYPE ────────────────────────────────────────────────────────────
#  Pick your hardware platform. This determines which AI backend is used and
#  how the GPU is configured — no other setup needed.
#
#  nvidia  NVIDIA GPU (uses vLLM, requires nvidia-container-toolkit)
#  amd     AMD RDNA 3+ / MI300+ GPU on Linux (uses vLLM with ROCm passthrough)
#          ⚠ also set COMPOSE_FILE below to apply the ROCm override
#  apple   Apple Silicon (uses Ollama on host with full Metal acceleration)
#          Setup: brew install ollama && ollama serve
#  native  Any other GPU (Intel Arc, AMD on Windows, older AMD, ...): uses Ollama
#          running on the host, which drives the GPU itself (CUDA/ROCm/Vulkan).
#          On Linux, Ollama must listen beyond loopback: OLLAMA_HOST=0.0.0.0
#  cpu     No GPU — runs Ollama in Docker on CPU only
#  custom  Bring your own models. Set the CUSTOM MODE section below.
#
#  Backend mapping:
#    nvidia  → vllm           amd   → vllm           apple/native → ollama-native
#    cpu     → ollama         custom → custom
# ─────────────────────────────────────────────────────────────────────────────

HARDWARE_TYPE=custom

# ── AMD GPU (HARDWARE_TYPE=amd) ──────────────────────────────────────────────
#  AMD uses vLLM with ROCm GPU device passthrough. The override file
#  (docker-compose.rocm.yml) swaps the NVIDIA deploy block for AMD device
#  passthrough (/dev/kfd, /dev/dri) and sets the ROCm vLLM image.
#  Set COMPOSE_FILE to auto-apply it — then just run `docker compose up -d`:
#  ⚠ Requires Docker Compose >= 2.24.0 (the override uses the `!reset` merge
#     tag to clear the NVIDIA device block — run `docker compose version`
#     to check if AMD device passthrough isn't working).
#
#COMPOSE_FILE=docker-compose.yml:docker-compose.rocm.yml
#
#  The ROCm vLLM image is set by setup.sh from your GPU's gfx target. The
#  rocm10.x images are unified — one tag covers RDNA 3/3.5/4 (Radeon RX
#  7000/9000, Strix Halo) and CDNA 3+ (Instinct MI300/MI325/MI350).
#
#VLLM_ROCM_IMAGE=rocm/vllm:rocm10.1.0_ubuntu24.04_py3.14-pytorch_2.13.0_vllm-0.29.0

# ── vLLM tuning (HARDWARE_TYPE=nvidia or amd) ───────────────────────────────
#  docker/vllm/serve.py picks quantization and GPU memory automatically from the
#  GPU it sees: FP8 on NVIDIA Ampere+ and AMD MI300+, BF16 elsewhere, and a
#  memory budget in GB sized to the model and to what is actually free, so a
#  shared or unified-memory GPU never crash-loops. Override only if needed:
#
#VLLM_QUANTIZATION=auto          # auto | fp8 | bf16
#VLLM_GPU_MEMORY_GB=             # budget for the main model, in GB
#VLLM_GPU_MEMORY_UTIL=auto       # raw vLLM fraction; overrides the GB budget
#VLLM_MAX_MODEL_LEN=16384
#VLLM_EMBED_MAX_MODEL_LEN=8192    # embedder context cap; see the note below

# ── COMPOSE_PROFILES (derived from HARDWARE_TYPE — don't edit) ───────────────
#  Auto-starts the right model-server container(s) for your hardware.
#  nvidia/amd → vLLM containers | cpu → Ollama container | apple/native/custom → none
# ─────────────────────────────────────────────────────────────────────────────

COMPOSE_PROFILES=${HARDWARE_TYPE}


# ── LOCAL MODE ───────────────────────────────────────────────────────────────
#  Only used when HARDWARE_TYPE is nvidia, amd, apple, native, or cpu (not custom).
#  A single multimodal model handles both vision captioning and summarization.
#
#  MODEL_FAMILY:
#    qwen   → Qwen3-VL  (recommended, Apache 2.0, strong OCR/vision)
#    gemma  → Gemma 3      (Apache 2.0, good alternative)
#
#  VRAM_TIER    model           GPU memory needed (setup.sh picks the largest that fits)
#                               Ollama Q4   vLLM FP8   vLLM BF16 (AMD RDNA)
#    low        Qwen3-VL-4B       ≥ 6 GB     ≥ 12 GB    ≥ 16 GB
#    mid        Qwen3-VL-8B       ≥ 10 GB    ≥ 24 GB    ≥ 32 GB   ← recommended
#    high       Qwen3-VL-32B      ≥ 24 GB    ≥ 51 GB    ≥ 81 GB
#    ultra      Qwen3-VL-235B     ≥ 192 GB   multi-GPU only (never auto-selected)
#
#  vLLM totals include the embedder and KV cache. On unified-memory machines
#  (DGX Spark, Strix Halo) setup picks "mid": their memory bandwidth makes the
#  32B model several times slower per frame. Set VRAM_TIER=high to opt in.
#
#  ⚠ HARDWARE_TYPE=apple / native: Ollama runs on your host, so the models must be
#    pulled there (setup.sh does this; the dockerized Ollama backend auto-pulls):
#      ollama pull qwen3-embedding:4b          # embeddings (all tiers)
#      ollama pull qwen3-vl:8b                 # vision+summaries (mid/qwen)
#    Swap the second for your tier: qwen3-vl:4b / :8b / :32b / :235b
#    (or gemma3:4b / :12b / :27b when MODEL_FAMILY=gemma).
# ─────────────────────────────────────────────────────────────────────────────

MODEL_FAMILY=qwen
VRAM_TIER=mid


# ── CUSTOM MODE ──────────────────────────────────────────────────────────────
#  Only used when HARDWARE_TYPE=custom. These are IGNORED in nvidia, amd, apple,
#  native, and cpu modes — those backends auto-configure their URLs and model names
#  from the tier registry (MODEL_FAMILY × VRAM_TIER), so editing the values
#  below has no effect unless HARDWARE_TYPE=custom.
#
#  Point each URL to your own vLLM / Ollama / LiteLLM / etc. endpoint.
#  Model names must match what your server reports at /v1/models.
# ─────────────────────────────────────────────────────────────────────────────

# Embedding model (OpenAI /v1/embeddings compatible)
EMBED_URL=http://your-server:8001
EMBED_MODEL=Qwen/Qwen3-Embedding-4B

# Vision / captioning model (OpenAI /v1/chat/completions with image_url)
VLM_URL=http://your-server:8000
VLM_MODEL=llava-hf/llava-v1.6-vicuna-7b-hf

# Text LLM for summarization (OpenAI /v1/chat/completions)
LLM_URL=http://your-server:8000
LLM_MODEL=Qwen/Qwen3-8B


# ── STORAGE ──────────────────────────────────────────────────────────────────
#
#  Up to 5 video library directories. Each is mounted read-only into the
#  container. Set as many as you need; unused slots can be left blank or omitted.
#
#  Examples:
#    VIDEO_DIR_1=/Users/you/Movies
#    VIDEO_DIR_2=/Volumes/NAS/Videos
#    VIDEO_DIR_3=/Volumes/ExternalDrive/Recordings
#
#  ⚠ Network shares (SMB/NFS) on Docker Desktop (macOS/Windows): pointing
#    VIDEO_DIR_* at a host-mounted network share (e.g. /Volumes/NAS) is
#    UNRELIABLE — Docker Desktop's file sharing lets the mount go stale
#    ("Not a directory" / "Bad file descriptor") and imports fail. Instead,
#    mount the share into the container directly with a CIFS/NFS volume. See
#    README ("Videos on a NAS / network share") for a copy-paste example.
# ─────────────────────────────────────────────────────────────────────────────

VIDEO_DIR_1=/path/to/your/videos
#VIDEO_DIR_2=
#VIDEO_DIR_3=
#VIDEO_DIR_4=
#VIDEO_DIR_5=

# ── DATA STORAGE ─────────────────────────────────────────────────────────────
#
#  All persistent data defaults to ./data/ inside the project directory.
#  On a machine with a small boot disk or when migrating, point these at an
#  external volume so you don't have to edit docker-compose.yml directly.
#
#  QDRANT_STORAGE_PATH  — where Qdrant persists its vector collections
#                         default: ./data/qdrant
#                         e.g.   : /Volumes/Data/vss-data/qdrant
#
#  DATABASE_URL         — SQLite metadata db path *inside the container*
#                         The host path comes from the volume mount above;
#                         override both together when relocating.
#                         default: sqlite+aiosqlite:////data/metadata.db
#                         e.g.   : sqlite+aiosqlite:////external/metadata.db
#
#  Migration tip: copy ./data/qdrant → new path, copy ./data/metadata.db →
#  new path, then set these vars. No re-indexing needed.
# ─────────────────────────────────────────────────────────────────────────────

#QDRANT_STORAGE_PATH=./data/qdrant
DATABASE_URL=sqlite+aiosqlite:////data/metadata.db


# ── MODEL STORAGE ────────────────────────────────────────────────────────────
#
#  Where downloaded model weights are stored on the host. Point this at a
#  larger drive if your boot disk is small — LLM/VLM weights can be tens of GB.
#
#  Holds every locally-downloaded model in one place:
#    <MODELS_DIR>/huggingface   reranker, plus vLLM & embed weights (HF cache)
#    <MODELS_DIR>/ollama        Ollama models (only with HARDWARE_TYPE=cpu)
#
#  Default is ./data/models (inside the project). Set an absolute path to
#  relocate, e.g. MODELS_DIR=/mnt/bigdrive/vss-models
#
#  Note: changing this after models are already downloaded means they will
#  re-download to the new location on next start. Move the old folder first
#  to avoid re-downloading.
# ─────────────────────────────────────────────────────────────────────────────

#MODELS_DIR=./data/models


# ── PROCESSING ───────────────────────────────────────────────────────────────

# Extract one frame every N seconds during analysis (lower = more detail, slower)
FRAME_EXTRACTION_INTERVAL=5

# Number of captions embedded per batch
EMBED_BATCH_SIZE=16

# Whisper transcription model (faster-whisper). Larger = more accurate, slower.
#   base | small | medium | large-v3 | distil-large-v3
# Transcript quality feeds directly into search quality, so prefer medium or
# better when you have the CPU/GPU headroom. Changing this only affects newly
# transcribed videos — use "↺ Audio" on a video to re-transcribe it.
#WHISPER_MODEL=medium

# Device and precision for Whisper. "cpu" + "int8" works everywhere; switch to
# "cuda" + "float16" for a large speedup when a GPU is available to the API
# container (the model then competes with vLLM for VRAM).
#WHISPER_DEVICE=cpu
#WHISPER_COMPUTE_TYPE=int8

# FFmpeg hardware acceleration for video decoding
#   off     — CPU decode only (default, works everywhere)
#   auto    — auto-detect the best GPU-accelerated decoder (cuda > vaapi > drm > vulkan)
#   cuda    — NVIDIA GPUs (DGX Spark / GB10 with nvidia-container-toolkit)
#   vaapi   — AMD / Intel GPUs on Linux (requires /dev/dri passthrough in container)
#   drm     — Linux Direct Rendering Manager (kernel-level decode)
#   vulkan  — cross-platform GPU decode via Vulkan video
# FFMPEG_HWACCEL=off


# ── AUTOMATION ───────────────────────────────────────────────────────────────
#  Optional. These set the INITIAL defaults for the automation features. Changes
#  made later in the Settings UI are saved separately and take precedence, so
#  editing these after first run has no effect on an existing install — use the
#  Settings page instead.
# ─────────────────────────────────────────────────────────────────────────────

# Auto-import: minutes between library scans for new videos. 0 = scan on startup only.
#AUTO_IMPORT_INTERVAL=0

# Auto-analyze newly imported videos. One of: off | audio | video | both
#   off    don't analyze automatically (import only)
#   audio  transcribe speech only
#   video  visual frame captioning only
#   both   transcribe + visual captioning
#AUTO_ANALYZE=off

# Context applied to auto-analyzed videos (used for video/both). Optional.
#DEFAULT_CONTEXT=

# Comma-separated glob patterns; matching file paths are never imported.
# e.g. IMPORT_BLACKLIST=*/broll/*,*/_archive/*
#IMPORT_BLACKLIST=


# ── PORTS ────────────────────────────────────────────────────────────────────
#  Override if the defaults conflict with something else already running.
#  Docker will tell you on startup if a port is already in use.
# ─────────────────────────────────────────────────────────────────────────────

#FRONTEND_PORT=3000
#API_PORT=8000
#QDRANT_PORT=6333
#OLLAMA_PORT=11434        # only used with HARDWARE_TYPE=cpu

# How long Ollama keeps a model loaded in memory after the last request.
# -1 = forever (default, matches vLLM behavior — no reload latency during analysis).
# 30m / 60m = timed (frees VRAM after idle period).
# 0 = unload immediately after each response.
# Only applies to HARDWARE_TYPE=cpu and apple; vLLM keeps models loaded
# indefinitely and is unaffected by this setting.
#OLLAMA_KEEP_ALIVE=-1

# vLLM Docker image — pinned to a stable release. Override to upgrade or to use
# a custom build. Avoid :latest — it tracks nightly builds, which change between
# pulls and are where breaking changes land first.
#VLLM_IMAGE=vllm/vllm-openai:v0.33.0

# vLLM quantization for both model containers
# auto — default. FP8 where the GPU has native FP8 hardware, otherwise BF16.
# fp8  — halves LLM decoder weights; vision encoder stays BF16.
#        Native on Hopper (H100), Ada Lovelace (RTX 40xx), Blackwell (GB10/B200)
#        and AMD MI300+ (gfx94x/gfx95x). RDNA (gfx11x/gfx12x) has no FP8 kernel
#        in vLLM at all, so forcing fp8 there fails to start.
# bf16 — 16-bit weights. Largest and, on AMD, fastest. Opt in explicitly.
#VLLM_QUANTIZATION=auto

# GPU memory fraction reserved by the embedding container (Qwen3-Embedding-4B,
# ~7.5 GB BF16). Kept low because vllm-embed shares the GPU with
# vllm-main — without a cap it defaults to vLLM's built-in 90%, which fails
# whenever both containers share a single GPU/unified-memory device (e.g. one
# dedicated GPU, or an AMD iGPU) since vllm-main has already reserved its own
# share.
# Left unset ("auto"), a small discrete GPU (≤16 GB, detected via nvidia-smi)
# gets a slightly higher 0.25 floor so the embedder's weights always fit.
# NOTE: with a 4B embedder, 0.1 is too small on a ≤16 GB card — use ≥0.55 there.
# Leave this commented out ("auto") unless you have a specific reason: the GB
# budgeter in serve.py already reserves ~12 GB for the embedder, and setting a
# raw fraction here bypasses that budget entirely.
#VLLM_EMBED_GPU_MEMORY_UTIL=0.55
#
# The embedder's context window. Embeddings are computed over short transcript
# and caption chunks, so 8192 is ample. Do NOT raise this without also raising
# the embedder's memory budget: the KV cache scales linearly with it, and vLLM
# refuses to start (rather than degrading) if the cache does not fit.
#VLLM_EMBED_MAX_MODEL_LEN=8192

# Fraction of GPU VRAM vLLM may reserve for the main VLM container. Left
# unset ("auto"), the cap is chosen automatically:
#   - Small discrete GPU (≤32 GB total VRAM, detected via nvidia-smi — the
#     common single-card case: RTX PRO 4000, RTX 4090, RTX 3090, etc.):
#     fixed 0.75, verified to leave enough headroom for KV cache alongside
#     an 8B-class FP8 model + the embedding container.
#   - Otherwise (large/unified-memory pools — Strix Halo, GB10, multi-GPU
#     servers — where nvidia-smi is absent or reports >32 GB), the cap
#     scales with VRAM_TIER instead, since a small model only needs a
#     small fraction of a much larger pool:
#       low -> 0.25    mid -> 0.35    high -> 0.60    ultra -> 0.92
# Set an explicit value to override either auto behavior (e.g. raise toward
# 0.90 if you need more KV cache capacity, or lower it to leave more VRAM
# free for other workloads on the same GPU).
#VLLM_GPU_MEMORY_UTIL=0.35

# vLLM containers (--profile vllm) do NOT expose host ports by default —
# the API reaches them via Docker's internal network, so no conflict is possible.
# Uncomment in docker-compose.yml if you need external/debug access.
