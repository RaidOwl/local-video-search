# ════════════════════════════════════════════════════════════════════════════
#  Local Video Search — Configuration
# ════════════════════════════════════════════════════════════════════════════
#
#  Copy this file to .env and edit as needed.
#
# ── AI_BACKEND ───────────────────────────────────────────────────────────────
#
#  custom         Bring your own models. Set the CUSTOM MODE section below.
#                 Run: docker compose up -d
#
#  ollama         Ollama runs inside Docker. Good for CPU or NVIDIA on Linux.
#                 ⚠ Apple Silicon: Docker VM loses Metal — use ollama-native.
#                 Run: docker compose --profile ollama up -d
#
#  ollama-native  Ollama runs on your host machine outside Docker.
#                 ✅ Best for Apple Silicon — full Metal/MLX acceleration.
#                 Setup: brew install ollama && ollama serve
#                 Then:  docker compose up -d   (no --profile needed)
#
#  vllm           vLLM runs in Docker. Requires NVIDIA GPU + nvidia-container-toolkit.
#                 Run: docker compose --profile vllm up -d
#
#  Already running Ollama or vLLM somewhere?
#  → Use AI_BACKEND=custom and point the CUSTOM MODE URLs at your existing servers.
#    No extra profile or containers needed.
#
# ─────────────────────────────────────────────────────────────────────────────

AI_BACKEND=custom


# ── LOCAL MODE ───────────────────────────────────────────────────────────────
#  Only used when AI_BACKEND is ollama, ollama-native, or vllm.
#  A single multimodal model handles both vision captioning and summarization.
#
#  MODEL_FAMILY:
#    qwen   → Qwen2.5-VL  (recommended, Apache 2.0, strong OCR/vision)
#    gemma  → Gemma 3      (Apache 2.0, good alternative)
#
#  VRAM_TIER:                 ollama (Q4)          vLLM (FP8, decoder only)
#    low    ≤8 GB            Qwen2.5-VL-3B        Qwen2.5-VL-3B
#    mid    ≤24 GB           Qwen2.5-VL-7B        Qwen2.5-VL-7B   ← recommended
#    high   ≤80 GB           Qwen2.5-VL-32B*      Qwen2.5-VL-32B  (e.g. DGX Spark GB10)
#    ultra  ≥128 GB          Qwen2.5-VL-72B*      Qwen2.5-VL-72B  (multi-GPU server)
#
#  * Ollama Q4: 32B ≈ 20 GB, 72B ≈ 45 GB. vLLM FP8 note: FP8 quantizes the
#    LLM decoder only — the vision encoder stays BF16 (~8 GB extra).
#    32B FP8 ≈ 35 GB total · 72B FP8 ≈ 80 GB total.
#  Note: VRAM_TIER for ollama-native refers to unified memory on Apple Silicon.
# ─────────────────────────────────────────────────────────────────────────────

MODEL_FAMILY=qwen
VRAM_TIER=mid


# ── CUSTOM MODE ──────────────────────────────────────────────────────────────
#  Only used when AI_BACKEND=custom.
#  Point each URL to your own vLLM / Ollama / LiteLLM / etc. endpoint.
#  Model names must match what your server reports at /v1/models.
#
#  Already running vLLM or Ollama and using a local mode (ollama/vllm)?
#  You can still set these URLs to redirect a local mode at your existing
#  servers instead of the auto-spun containers — the system honours them
#  as long as they don't look like the default localhost placeholders.
# ─────────────────────────────────────────────────────────────────────────────

# Embedding model (OpenAI /v1/embeddings compatible)
VLLM_EMBED_URL=http://10.0.0.30:8001
VLLM_EMBED_MODEL=BAAI/bge-m3

# Vision / captioning model (OpenAI /v1/chat/completions with image_url)
VLLM_VLM_URL=http://10.0.0.19:8000
VLLM_VLM_MODEL=llava-hf/llava-v1.6-vicuna-7b-hf

# Text LLM for summarization (OpenAI /v1/chat/completions)
VLLM_URL=http://10.0.0.30:8000
VLLM_MODEL=Qwen/Qwen3-8B


# ── STORAGE ──────────────────────────────────────────────────────────────────
#
#  Up to 5 video library directories. Each is mounted read-only into the
#  container. Set as many as you need; unused slots can be left blank or omitted.
#
#  Examples:
#    VIDEO_DIR_1=/Users/you/Movies
#    VIDEO_DIR_2=/Volumes/NAS/Videos
#    VIDEO_DIR_3=/Volumes/ExternalDrive/Recordings
# ─────────────────────────────────────────────────────────────────────────────

VIDEO_DIR_1=/path/to/your/videos
#VIDEO_DIR_2=
#VIDEO_DIR_3=
#VIDEO_DIR_4=
#VIDEO_DIR_5=

# Database location (inside the container's /data volume)
DATABASE_URL=sqlite+aiosqlite:////data/metadata.db


# ── MODEL STORAGE ────────────────────────────────────────────────────────────
#
#  Where downloaded model weights are stored on the host. Point this at a
#  larger drive if your boot disk is small — LLM/VLM weights can be tens of GB.
#
#  Holds every locally-downloaded model in one place:
#    <MODELS_DIR>/huggingface   reranker, plus vLLM & embed weights (HF cache)
#    <MODELS_DIR>/ollama        Ollama models (only with --profile ollama)
#
#  Default is ./data/models (inside the project). Set an absolute path to
#  relocate, e.g. MODELS_DIR=/mnt/bigdrive/vss-models
#
#  Note: changing this after models are already downloaded means they will
#  re-download to the new location on next start. Move the old folder first
#  to avoid re-downloading.
# ─────────────────────────────────────────────────────────────────────────────

#MODELS_DIR=./data/models


# ── PROCESSING ───────────────────────────────────────────────────────────────

# Extract one frame every N seconds during analysis (lower = more detail, slower)
FRAME_EXTRACTION_INTERVAL=5

# Number of captions embedded per batch
EMBED_BATCH_SIZE=16


# ── PORTS ────────────────────────────────────────────────────────────────────
#  Override if the defaults conflict with something else already running.
#  Docker will tell you on startup if a port is already in use.
# ─────────────────────────────────────────────────────────────────────────────

#FRONTEND_PORT=3000
#API_PORT=8000
#QDRANT_PORT=6333
#OLLAMA_PORT=11434        # only used with --profile ollama

# vLLM Docker image — pin to a specific version or use a custom build
#VLLM_IMAGE=vllm/vllm-openai:latest

# vLLM quantization for the main VLM container
# fp8  — default; halves LLM decoder weights; vision encoder stays BF16
#        works on Hopper (H100), Ada Lovelace (RTX 40xx), Blackwell (GB10/B200)
# awq  — 4-bit; requires an AWQ model variant (e.g. *-Instruct-AWQ on HF)
#VLLM_QUANTIZATION=fp8

# Fraction of GPU VRAM vLLM may reserve (default 0.75 leaves headroom for the
# vision encoder activations and system processes on unified memory systems).
# Raise toward 0.90 on discrete GPUs if you need more KV cache capacity.
#VLLM_GPU_MEMORY_UTIL=0.75

# vLLM containers (--profile vllm) do NOT expose host ports by default —
# the API reaches them via Docker's internal network, so no conflict is possible.
# Uncomment in docker-compose.yml if you need external/debug access.
