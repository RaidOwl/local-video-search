# AI Service Endpoints (configure based on your setup)

# Remote cluster (DGX Spark + Strix Halo)
OLLAMA_EMBED_URL=http://spark1:11434
OLLAMA_VLM_URL=http://strixhalo:11434
VLLM_URL=http://strixhalo:8000
QDRANT_URL=http://spark2:6333

# Option B: Local containers (uncomment if using local services)
# OLLAMA_EMBED_URL=http://ollama-embed:11434
# OLLAMA_VLM_URL=http://ollama-vlm:11434
# VLLM_URL=http://vllm:8000
# QDRANT_URL=http://qdrant:6333

# Storage
VIDEO_DIR=/data/videos
VIDEO_DIR_PATH=./data/videos

# Processing Config
FRAME_EXTRACTION_INTERVAL=5
EMBED_BATCH_SIZE=16

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/metadata.db